{
  "name": "ash-frontend",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node build-adapters.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src adapters tests *.json *.ts *.mjs index.html",
    "format:check": "prettier --check src adapters tests *.json *.ts *.mjs index.html"
  },
  "dependencies": {
    "vue": "3.5.42",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "esbuild": "0.25.12",
    "prettier": "3.7.4",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vitest": "3.2.4",
    "vue-tsc": "2.2.12"
  }
}
